#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Tell Home Assistant the app is here.
#
# The Supervisor turns this into a `voice_support` config flow with the host and
# port below, so nothing has to be typed anywhere and the app is forgotten
# again when it is uninstalled.
# ==============================================================================
declare config

# Don't announce an app that isn't answering yet: the integration asks for
# /info as soon as it is set up.
bash -c "until curl -sf http://localhost:10800/health > /dev/null; do sleep 0.5; done" \
    || true

config=$(bashio::var.json host "$(hostname)" port "^10800")

if bashio::discovery "voice_support" "${config}" > /dev/null; then
    bashio::log.info "Successfully sent discovery information to Home Assistant."
else
    bashio::log.error "Discovery message to Home Assistant failed!"
fi
